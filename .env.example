# --- LLM provider -------------------------------------------------------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Provider: gemini | echo   (echo = offline stub, no key needed)
LAWHUB_LLM=gemini

# Model name. Check https://ai.google.dev/gemini-api/docs/models for the
# current list; a "flash" tier is plenty for this workload.
LAWHUB_MODEL=gemini-3.5-flash-lite
